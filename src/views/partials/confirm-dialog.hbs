<dialog id="confirm-dialog">
  <form method="dialog">
    <p class="title is-5">Are you sure?</p>
    <p id="confirm-message" class="mb-5"></p>
    <div class="buttons is-right">
      <button class="button" value="cancel">Cancel</button>
      <button class="button is-danger" value="ok">Delete</button>
    </div>
  </form>
</dialog>