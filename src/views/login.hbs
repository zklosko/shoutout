<form method="POST" action="/login" hx-boost="false">
  {{#if error}}
    <p class="is-warning">Invalid username or password.</p>
  {{/if}}
  <label>Username
    <input class="input" type="text" name="username" required /></label>
  <label>Password
    <input class="input" type="password" name="password" required /></label>
  <button class="button is-primary" type="submit">Log in</button>
</form>