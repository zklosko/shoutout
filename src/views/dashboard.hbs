<section class="section">
    <h1 class="title">Dashboard</h1>
    <h2 class="subtitle">Submit a new child number</h2>
    <form hx-post="/request/new" hx-target="#new-child-result" hx-swap="innerHTML">
        <div class="field">
            <label for="childCode">Child Code</label>
            <div class="control">
                <input class="input" type="text" name="childCode" placeholder="123">
            </div>
        </div>
        <div class="field">
            <label for="note">Note (optional)</label>
            <div class="control">
                <input class="input" type="text" name="note" placeholder="Mom needs to come get him">
            </div>
        </div>

        <div class="field is-grouped">
            <p class="control">
                <button class="button is-primary" type="submit">Submit</button>
            </p>
            <p class="control">
                <button class="button is-secondary" type="reset">Reset</button>
            </p>
        </div>
    </form>
    <div id="new-child-result"></div>

    <h2 class="subtitle mt-4">Submissions</h2>
    <table class="table is-fullwidth is-hoverable">
        <thead>
            <th>Child number</th>
            <th>Note</th>
            <th>Status</th>
            <th>Actions</th>
        </thead>
        <tbody>
            {{#each childCodes}}
                {{> code-row}}
            {{/each}}
        </tbody>
    </table>
</section>