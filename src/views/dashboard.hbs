<h1>Dashboard</h1>

<div>
    <h2>Submit a new child number</h2>
    <form hx-post="/requests/new" hx-boost="true" hx-target="#new-child-result" hx-swap="innerHTML">
        <label for="childCode">Child Code</label>
        <input type="text" name="childCode" placeholder="123">
        <label for="note">Note (optional)</label>
        <input type="text" name="note" placeholder="Needs Mom to come get him">
        <button type="submit">Submit</button>
        <button type="reset">Reset</button>
    </form>
    <div id="new-child-result"></div>
</div>

<div>
    <h2>Submissions</h2>
    <table>
        <thead>
            <th>Child number</th>
            <th>Note</th>
            <th>Status</th>
            <th>Actions</th>
        </thead>
        <tbody>
            {{#each childCodes}}
            <tr>
                <td>{{ childCode }}</td>
                <td>{{ note }}</td>
                <td>{{ status }}</td>
                <td>
                    <button hx-post="/request/approve/{{ childCode }}">Approve</button>
                    <button hx-post="/request/reject/{{ childCode }}">Reject</button>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>